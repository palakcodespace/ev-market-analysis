<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2024.1.0' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <AutoCreateAndUpdateDSDPhoneLayouts />
    <IntuitiveSorting />
    <IntuitiveSorting_EncodingByColor />
    <MapboxVectorStylesAndLayers />
    <MultiFieldSort />
    <SavePhoneLayoutsDefault />
  </document-format-change-manifest>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='tableau_ev_market_data' inline='true' name='federated.ev_market_data' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='tableau_ev_market_data' name='textscan.ev_market_data'>
            <connection class='textscan' directory='../data/processed' filename='tableau_ev_market_data.csv' password='' server='' />
          </named-connection>
        </named-connections>
      </connection>
      <column datatype='integer' name='[sales_year]' role='dimension' type='ordinal' />
      <column datatype='string' name='[manufacturer]' role='dimension' type='nominal' />
      <column datatype='string' name='[vehicle_category]' role='dimension' type='nominal' />
      <column datatype='string' name='[market_region]' role='dimension' type='nominal' />
      <column datatype='integer' name='[annual_sales_units]' role='measure' type='quantitative' />
      <column datatype='real' name='[market_share_pct]' role='measure' type='quantitative' />
      <column datatype='real' name='[avg_battery_capacity_kwh]' role='measure' type='quantitative' />
      <column datatype='real' name='[avg_electric_range_km]' role='measure' type='quantitative' />
      <column datatype='real' name='[avg_price_msrp_usd]' role='measure' type='quantitative' />
      <column datatype='real' name='[avg_customer_rating]' role='measure' type='quantitative' />
      <column datatype='string' name='[primary_battery_tech]' role='dimension' type='nominal' />
      <column datatype='string' name='[manufacturing_country]' role='dimension' type='nominal' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Annual EV Sales Trend'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.ev_market_data' />
          </datasources>
          <datasource-dependencies datasource='federated.ev_market_data'>
            <column datatype='integer' name='[sales_year]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[annual_sales_units]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.ev_market_data].[annual_sales_units]</rows>
        <cols>[federated.ev_market_data].[sales_year]</cols>
      </table>
    </worksheet>
    <worksheet name='Manufacturer Sales Ranking'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.ev_market_data' />
          </datasources>
          <datasource-dependencies datasource='federated.ev_market_data'>
            <column datatype='string' name='[manufacturer]' role='dimension' type='nominal' />
            <column datatype='integer' name='[annual_sales_units]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.ev_market_data].[manufacturer]</rows>
        <cols>[federated.ev_market_data].[annual_sales_units]</cols>
      </table>
    </worksheet>
    <worksheet name='Battery Capacity vs Range'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.ev_market_data' />
          </datasources>
          <datasource-dependencies datasource='federated.ev_market_data'>
            <column datatype='real' name='[avg_battery_capacity_kwh]' role='measure' type='quantitative' />
            <column datatype='real' name='[avg_electric_range_km]' role='measure' type='quantitative' />
            <column datatype='string' name='[primary_battery_tech]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
          </pane>
        </panes>
        <rows>[federated.ev_market_data].[avg_electric_range_km]</rows>
        <cols>[federated.ev_market_data].[avg_battery_capacity_kwh]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='EV Market Intelligence Dashboard'>
      <style />
      <size maxheight='1200' maxwidth='1400' minheight='1200' minwidth='1400' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='48000' id='2' name='Annual EV Sales Trend' w='50000' x='0' y='0' />
          <zone h='48000' id='3' name='Manufacturer Sales Ranking' w='50000' x='50000' y='0' />
          <zone h='52000' id='4' name='Battery Capacity vs Range' w='100000' x='0' y='48000' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows>
    <window class='dashboard' name='EV Market Intelligence Dashboard'>
      <viewpoints />
      <active id='-1' />
    </window>
  </windows>
</workbook>
