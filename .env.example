# ====================================================================
# Electric Vehicle Market Analysis and Intelligence System
# Environment Configuration Template (.env.example)
# ====================================================================

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-key-in-production
PORT=5000

# Database Configuration (MySQL 8)
USE_MYSQL=False
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=ev_market_db

# Direct SQLAlchemy Database URI (Optional - overrides individual settings)
# Example for MySQL: mysql+pymysql://root:password@localhost:3306/ev_market_db
# Example for SQLite: sqlite:///database/ev_market_db.sqlite
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ev_market_db

# Tableau Public / Tableau Cloud Integration (Optional)
# If left blank, Flask presents native Plotly.js charts with explanatory notices.
# Example: https://public.tableau.com/views/ElectricVehicleMarketAnalysis/Dashboard
TABLEAU_DASHBOARD_URL=
TABLEAU_STORY_URL=
